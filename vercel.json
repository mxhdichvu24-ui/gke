{
  "framework": "vite",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/warehouse-3d",
      "destination": "/gke-3d",
      "permanent": false
    },
    {
      "source": "/vi/kho-3d",
      "destination": "/vi/gke-3d",
      "permanent": false
    },
    {
      "source": "/zh/warehouse-3d",
      "destination": "/zh/gke-3d",
      "permanent": false
    }
  ],
  "regions": [
    "syd1"
  ],
  "rewrites": [
    {
      "source": "/vi/kien-thuc",
      "destination": "/api/articles?lang=vi"
    },
    {
      "source": "/vi/kien-thuc/:slug",
      "destination": "/api/articles?lang=vi&slug=:slug"
    },
    {
      "source": "/resources",
      "destination": "/api/articles?lang=en"
    },
    {
      "source": "/resources/:slug",
      "destination": "/api/articles?lang=en&slug=:slug"
    },
    {
      "source": "/zh/resources",
      "destination": "/api/articles?lang=zh"
    },
    {
      "source": "/zh/resources/:slug",
      "destination": "/api/articles?lang=zh&slug=:slug"
    }
  ]
}
